function buildCard(session, index) {
  const wrap = document.createElement('div');
  wrap.className = 'card-wrap' + (session.incomplete ? ' incomplete' : '');
  wrap.style.animationDelay = `${index * 0.07}s`;

  const isArray = Array.isArray(session.quote);
  const frontQuote = isArray
    ? `<span class="session-quote terminal-quote" data-lines='${JSON.stringify(session.quote)}'></span>`
    : `<span class="session-quote">${session.quote}</span>`;

  wrap.innerHTML = `
    <div class="card">
      <div class="card-front">
        <span class="session-number">${session.number}</span>
        <span class="session-title">${session.title}</span>
        ${frontQuote}
        <span class="flip-hint">✦ reveal ✦</span>
      </div>
      <div class="card-back">
        <div class="card-back-header">${session.number}</div>
        <div class="card-back-title">${session.title}</div>
        <div class="card-back-text">${session.blurb}</div>
      </div>
    </div>
  `;

  wrap.addEventListener('click', () => {
    wrap.classList.toggle('flipped');
    // start terminal animation on flip if needed
    const tq = wrap.querySelector('.terminal-quote');
    if (tq && !tq.dataset.started) {
      tq.dataset.started = 'true';
      const lines = JSON.parse(tq.dataset.lines);
      let i = 0;
      function nextLine() {
        if (i >= lines.length) return;
        const d = document.createElement('div');
        d.textContent = lines[i] || '\u00A0';
        d.style.opacity = '0';
        d.style.animation = 'termFade 0.15s forwards';
        tq.appendChild(d);
        i++;
        setTimeout(nextLine, 220);
      }
      nextLine();
    }
  });
  return wrap;
}

const act1Grid = document.getElementById('act1-grid');
