function drawPixelCircle(c,cx,cy,r,color){
  // Midpoint circle pixel squares
  c.fillStyle=color;
  let x=r,y=0,err=0;
  while(x>=y){
    [[x,y],[y,x],[-y,x],[-x,y],[-x,-y],[-y,-x],[y,-x],[x,-y]].forEach(([ox,oy])=>{
      c.fillRect(Math.round(cx+ox-2),Math.round(cy+oy-2),4,4);
    });
    y++; err+=1+2*y;
    if(2*(err-x)+1>0){ x--; err+=1-2*x; }
  }
}

