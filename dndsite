<script>
(function(){
'use strict';
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
ctx.imageSmoothingEnabled = false;
const W = 1720, H = 960;
canvas.width = W; canvas.height = H;

const victoryCanvas = document.getElementById('victoryCanvas');
const vCtx = victoryCanvas.getContext('2d');

// ── PIXEL HELPERS ─────────────────────────────────────────
function px(x,y,w,h,color){
  ctx.fillStyle = color;
  ctx.fillRect(Math.round(x), Math.round(y), w, h);
}
function vpx(c,x,y,w,h,color){
  c.fillStyle = color;
  c.fillRect(Math.round(x), Math.round(y), w, h);
}

// ── STATE ─────────────────────────────────────────────────
let gameRunning = false;
let keys = {};
let particles = [], bloodSplats = [], slashFx = [], chainFx = [], novaFx = null, sobTexts = [];
let kills = 0;
let screenShake = 0;
let bgStars = [];
let lavaPulse = 0;

// Map obstacles (rock pillars)
const PILLARS = [
  {x:320,y:280,w:80,h:120},
  {x:1240,y:220,w:80,h:120},
  {x:780,y:380,w:100,h:80},
  {x:280,y:620,w:80,h:100},
  {x:1320,y:580,w:80,h:100},
  {x:740,y:680,w:90,h:80},
];

function collidesWithPillar(x, y, r) {
  for(const p of PILLARS){
    if(x+r > p.x && x-r < p.x+p.w && y+r > p.y && y-r < p.y+p.h) return p;
  }
  return null;
}

// ── ABILITIES ─────────────────────────────────────────────
const ABL = {
  dash:   { cd:0, maxCd:55,  key:'z', label:'DASH'  },
  slash:  { cd:0, maxCd:40,  key:'x', label:'SLASH' },
  nova:   { cd:0, maxCd:200, key:'c', label:'NOVA'  },
  chains: { cd:0, maxCd:160, key:'v', label:'CHAINS'},
};

// ── KAZRYN ────────────────────────────────────────────────
const KAZ = {
  x:W/2, y:H/2, vx:0, vy:0,
  speed:4.5,
  facing:1,
  dashTimer:0, dashDx:0, dashDy:0,
  swing:0,
  cloakT:0,
  chainTarget:-1,
};

// ── PARTY DEFS ────────────────────────────────────────────
const DEFS = [
  {name:'HARMONY', hair:'#f5d800', skin:'#e8c99a', dress:'#2a7a2a', type:'elf',     maxHp:3, x:300,  y:260},
  {name:'THESEUS', hair:'#444',    skin:'#aaaaaa', dress:'#3a5fa0', type:'goliath', maxHp:5, x:1280, y:220, big:true},
  {name:'AVAARIN', hair:'#ffffff', skin:'#c4a882', dress:'#80c8f0', type:'genasi',  maxHp:3, x:320,  y:700},
  {name:'ZETHRIA', hair:'#8b2faf', skin:'#7a4a8c', dress:'#222230', type:'tiefling',maxHp:4, x:1300, y:700},
];
let party = [];

function initParty(){
  party = DEFS.map(d=>({
    ...d,
    hp: d.maxHp,
    alive: true,
    vx:(Math.random()-0.5)*1.2,
    vy:(Math.random()-0.5)*1.2,
    fleeT:0,
    cryT:Math.random()*60,
    hurtT:0,
    deathT:0,
    chained:0,
    scale: d.big ? 1.4 : 1.0,
    bobT: Math.random()*100,
    fightT:0,
    // each member has a lil attack
    attackCd:0,
  }));
}

function resetGame(){
  kills=0;
  document.getElementById('kill-count').textContent='0';
  KAZ.x=W/2; KAZ.y=H/2; KAZ.vx=0; KAZ.vy=0; KAZ.dashTimer=0; KAZ.chainTarget=-1;
  particles=[]; bloodSplats=[]; slashFx=[]; chainFx=[]; novaFx=null; screenShake=0; sobTexts=[];
  Object.values(ABL).forEach(a=>a.cd=0);
  initParty();
  bgStars = Array.from({length:80},()=>({
    x:Math.random()*W, y:Math.random()*H,
    r:Math.random()<0.1?2:1,
    flicker:Math.random()*100
  }));
}

// ── INPUT ─────────────────────────────────────────────────
document.addEventListener('keydown',e=>{
  keys[e.key.toLowerCase()]=true;
  if(!gameRunning) return;
  const k = e.key.toLowerCase();
  if(k==='z') tryDash();
  if(k==='x') trySlash();
  if(k==='c') tryNova();
  if(k==='v') tryChains();
  e.preventDefault();
});
document.addEventListener('keyup',e=>{ keys[e.key.toLowerCase()]=false; });

function tryDash(){
  if(ABL.dash.cd>0) return;
  ABL.dash.cd = ABL.dash.maxCd;
  let dx=0,dy=0;
  if(keys['a']||keys['arrowleft'])  dx=-1;
  if(keys['d']||keys['arrowright']) dx=1;
  if(keys['w']||keys['arrowup'])    dy=-1;
  if(keys['s']||keys['arrowdown'])  dy=1;
  if(dx===0&&dy===0) dx=KAZ.facing;
  const l=Math.sqrt(dx*dx+dy*dy);
  KAZ.dashTimer=14; KAZ.dashDx=(dx/l)*32; KAZ.dashDy=(dy/l)*32;
  for(let i=0;i<18;i++) spawnParticle(KAZ.x,KAZ.y,
    -KAZ.dashDx*0.3+(Math.random()-0.5)*3,
    -KAZ.dashDy*0.3+(Math.random()-0.5)*3,
    '80,0,200', 1+Math.random()*2, 20+Math.random()*10);
}

function trySlash(){
  if(ABL.slash.cd>0) return;
  ABL.slash.cd = ABL.slash.maxCd;
  KAZ.swing=20;
  slashFx.push({x:KAZ.x,y:KAZ.y,facing:KAZ.facing,life:20,maxLife:20});
  screenShake=6;
  party.forEach(m=>{
    if(!m.alive) return;
    const dx=m.x-KAZ.x, dy=m.y-KAZ.y;
    if(Math.sqrt(dx*dx+dy*dy)<180 && dx*KAZ.facing>-50) hitMember(m, 1);
  });
}

function tryNova(){
  if(ABL.nova.cd>0) return;
  ABL.nova.cd = ABL.nova.maxCd;
  novaFx={r:0,maxR:440,life:45,maxLife:45};
  screenShake=12;
  for(let i=0;i<80;i++){
    const a=Math.random()*Math.PI*2, s=3+Math.random()*6;
    spawnParticle(KAZ.x,KAZ.y,Math.cos(a)*s,Math.sin(a)*s,'200,10,10',1+Math.random()*3,30+Math.random()*20);
  }
  party.forEach(m=>{
    if(!m.alive) return;
    const dx=m.x-KAZ.x, dy=m.y-KAZ.y;
    if(Math.sqrt(dx*dx+dy*dy)<440) hitMember(m,2);
  });
}

function tryChains(){
  if(ABL.chains.cd>0) return;
  ABL.chains.cd = ABL.chains.maxCd;
  // chain closest alive member
  let best=-1, bestD=99999;
  party.forEach((m,i)=>{
    if(!m.alive) return;
    const d=Math.sqrt((m.x-KAZ.x)**2+(m.y-KAZ.y)**2);
    if(d<bestD){ bestD=d; best=i; }
  });
  if(best>=0){
    KAZ.chainTarget=best;
    party[best].chained=120;
    chainFx.push({from:{x:KAZ.x,y:KAZ.y},to:party[best],life:40,maxLife:40});
    screenShake=4;
    for(let i=0;i<20;i++) spawnParticle(
      party[best].x,party[best].y,
      (Math.random()-0.5)*4,(Math.random()-0.5)*4,
      '200,50,200',1+Math.random()*2,25);
  }
}

function hitMember(m, dmg){
  if(!m.alive) return;
  m.hp -= dmg;
  m.hurtT = 18;
  // pain particles
  for(let i=0;i<12;i++){
    const a=Math.random()*Math.PI*2, s=1.5+Math.random()*3;
    spawnParticle(m.x,m.y,Math.cos(a)*s,Math.sin(a)*s,'180,10,10',1+Math.random()*3,20+Math.random()*15);
  }
  if(m.hp<=0) killMember(m);
}

function killMember(m){
  if(!m.alive) return;
  m.alive=false; m.hp=0; m.deathT=0;
  kills++;
  document.getElementById('kill-count').textContent=kills;
  screenShake=10;
  for(let i=0;i<50;i++){
    const a=Math.random()*Math.PI*2, s=1+Math.random()*6;
    spawnParticle(m.x,m.y,Math.cos(a)*s,Math.sin(a)*s,'160,8,8',1+Math.random()*4,30+Math.random()*25);
  }
  bloodSplats.push({x:m.x,y:m.y,r:22+Math.random()*18});
  if(kills>=4) setTimeout(showVictory,900);
}

function spawnParticle(x,y,vx,vy,color,r,life){
  particles.push({x,y,vx,vy,color,r,life,maxLife:life});
}

// ── UPDATE ─────────────────────────────────────────────────
function updateKazryn(){
  let dx=0,dy=0;
  if(keys['a']||keys['arrowleft'])  {dx-=1; KAZ.facing=-1;}
  if(keys['d']||keys['arrowright']) {dx+=1; KAZ.facing=1;}
  if(keys['w']||keys['arrowup'])    dy-=1;
  if(keys['s']||keys['arrowdown'])  dy+=1;

  if(dx||dy){
    const l=Math.sqrt(dx*dx+dy*dy);
    KAZ.vx=(dx/l)*KAZ.speed; KAZ.vy=(dy/l)*KAZ.speed;
  } else { KAZ.vx*=0.75; KAZ.vy*=0.75; }

  let nx=KAZ.x, ny=KAZ.y;
  if(KAZ.dashTimer>0){
    nx+=KAZ.dashDx; ny+=KAZ.dashDy; KAZ.dashTimer--;
  } else { nx+=KAZ.vx; ny+=KAZ.vy; }

  // pillar collision
  if(!collidesWithPillar(nx,KAZ.y,16)) KAZ.x=nx;
  if(!collidesWithPillar(KAZ.x,ny,16)) KAZ.y=ny;
  KAZ.x=Math.max(20,Math.min(W-20,KAZ.x));
  KAZ.y=Math.max(28,Math.min(H-28,KAZ.y));
  KAZ.cloakT++;
  if(KAZ.swing>0) KAZ.swing--;
}

function updateParty(){
  party.forEach((m,idx)=>{
    m.bobT++;
    if(!m.alive){ m.deathT=Math.min(m.deathT+1,60); return; }
    if(m.hurtT>0) m.hurtT--;
    if(m.chained>0){ m.chained--; return; }

    const dx=m.x-KAZ.x, dy=m.y-KAZ.y;
    const dist=Math.sqrt(dx*dx+dy*dy);
    let fx=0,fy=0;

    // flee
    if(dist<440){
      fx=(dx/dist)*2.4; fy=(dy/dist)*2.4;
      m.fleeT=40;
    } else if(m.fleeT>0){
      m.fleeT--; fx=m.vx*0.4; fy=m.vy*0.4;
    } else {
      if(Math.random()<0.015){ m.vx=(Math.random()-0.5)*1.4; m.vy=(Math.random()-0.5)*1.4; }
      fx=m.vx; fy=m.vy;
    }

    // avoid pillars
    for(const p of PILLARS){
      const pcx=p.x+p.w/2, pcy=p.y+p.h/2;
      const odx=m.x-pcx, ody=m.y-pcy;
      const od=Math.sqrt(odx*odx+ody*ody);
      if(od<100){ fx+=odx/od*2.5; fy+=ody/od*2.5; }
    }
    // avoid other members
    party.forEach(o=>{
      if(o===m||!o.alive) return;
      const ox=m.x-o.x,oy=m.y-o.y;
      const od=Math.sqrt(ox*ox+oy*oy);
      if(od<72){ fx+=ox/od*1.5; fy+=oy/od*1.5; }
    });

    const spd=2.2*m.scale;
    const fl=Math.sqrt(fx*fx+fy*fy);
    if(fl>0){ m.x+=fx/fl*spd; m.y+=fy/fl*spd; }

    // pillar bounce
    const pc=collidesWithPillar(m.x,m.y,20);
    if(pc){ m.vx*=-1; m.vy*=-1; m.x+=m.vx*3; m.y+=m.vy*3; }

    m.x=Math.max(28,Math.min(W-28,m.x));
    m.y=Math.max(36,Math.min(H-36,m.y));

    // cry tears — BIG ugly sobbing
    m.cryT--;
    if(m.cryT<=0){
      m.cryT = dist<560 ? 8+Math.random()*10 : 40+Math.random()*20;
      if(dist<560) {
        // left tear
        spawnParticle(m.x-3*m.scale, m.y-22*m.scale,
          -0.3+(Math.random()-0.5)*0.4, 1.4+Math.random(),
          '100,160,255', 6*m.scale, 42);
        // right tear
        spawnParticle(m.x+3*m.scale, m.y-22*m.scale,
          0.3+(Math.random()-0.5)*0.4, 1.4+Math.random(),
          '100,160,255', 6*m.scale, 42);
        // big splash drop
        if(dist<400){
          spawnParticle(m.x+(Math.random()-0.5)*6, m.y-18*m.scale,
            (Math.random()-0.5)*1.5, 2.8+Math.random(),
            '180,220,255', 10*m.scale, 48);
        }
        // sob text
        if(Math.random()<0.35){
          const sobs=['sob','...','pls','no!','help','waah','why','nooo'];
          sobTexts.push({
            x:m.x+(Math.random()-0.5)*22,
            y:m.y-36*m.scale,
            text:sobs[Math.floor(Math.random()*sobs.length)],
            life:55, maxLife:55, vy:-0.55
          });
        }
      }
    }

    // fight back weakly if close
    if(dist<100&&m.attackCd<=0){
      m.attackCd=90;
      // tiny shove particle back at kazryn
      const ang=Math.atan2(KAZ.y-m.y,KAZ.x-m.x);
      spawnParticle(m.x,m.y,Math.cos(ang)*3,Math.sin(ang)*3,'200,200,80',2,15);
    }
    if(m.attackCd>0) m.attackCd--;

    // contact kill
    if(dist<56) hitMember(m,1);
  });
}

function updateFx(){
  particles=particles.filter(p=>{
    p.x+=p.vx; p.y+=p.vy; p.vy+=0.07; p.vx*=0.97; p.life--; return p.life>0;
  });
  slashFx=slashFx.filter(s=>(s.life--,s.life>0));
  chainFx=chainFx.filter(c=>(c.life--,c.life>0));
  if(novaFx){ novaFx.r+=28; novaFx.life--; if(novaFx.life<=0) novaFx=null; }
  sobTexts=sobTexts.filter(s=>{ s.y+=s.vy; s.life--; return s.life>0; });
  if(screenShake>0) screenShake--;
  lavaPulse++;
  Object.values(ABL).forEach(a=>{ if(a.cd>0) a.cd--; });
}

// ── DRAW ──────────────────────────────────────────────────
function drawBg(){
  // hellish dark ground
  ctx.fillStyle='#08000a';
  ctx.fillRect(0,0,W,H);

  // lava cracks glow
  const lavaAlpha=0.12+Math.sin(lavaPulse*0.04)*0.06;
  ctx.strokeStyle=`rgba(200,60,0,${lavaAlpha})`;
  ctx.lineWidth=2;
  const cracks=[
    [[0,120],[80,200],[160,180],[200,260],[300,240]],
    [[W,80],[W-100,160],[W-180,150],[W-220,230]],
    [[100,H],[180,H-80],[240,H-60],[320,H-120]],
    [[W-80,H],[W-160,H-90],[W-280,H-70]],
    [[350,0],[380,80],[420,100],[440,200]],
  ];
  cracks.forEach(pts=>{
    ctx.beginPath(); ctx.moveTo(pts[0][0],pts[0][1]);
    for(let i=1;i<pts.length;i++) ctx.lineTo(pts[i][0],pts[i][1]);
    ctx.stroke();
    // subtle orange inner glow
    ctx.strokeStyle=`rgba(255,120,0,${lavaAlpha*0.5})`;
    ctx.lineWidth=1;
    ctx.stroke();
    ctx.strokeStyle=`rgba(200,60,0,${lavaAlpha})`;
    ctx.lineWidth=2;
  });

  // pixel star/ember dots above
  bgStars.forEach(s=>{
    const a=0.3+Math.sin(lavaPulse*0.06+s.flicker)*0.3;
    const col = s.r>1 ? `rgba(255,100,40,${a})` : `rgba(200,200,200,${a*0.5})`;
    px(s.x,s.y,s.r,s.r,col);
  });

  // pixel grid floor (subtle)
  ctx.strokeStyle='rgba(60,0,0,0.2)';
  ctx.lineWidth=1;
  for(let x=0;x<W;x+=32){ ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke(); }
  for(let y=0;y<H;y+=32){ ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke(); }
}

function drawPillars(){
  PILLARS.forEach(p=>{
    // shadow
    px(p.x+8,p.y+12,p.w,p.h,'rgba(0,0,0,0.5)');
    px(p.x,p.y,p.w,p.h,'#1a0a0a');
    px(p.x,p.y,4,p.h,'#2e1010');
    px(p.x,p.y,p.w,4,'#2e1010');
    px(p.x+p.w-4,p.y,4,p.h,'#0a0505');
    px(p.x,p.y+p.h-4,p.w,4,'#0a0505');
    ctx.fillStyle='rgba(180,30,30,0.25)';
    ctx.font='20px monospace'; ctx.textAlign='center';
    ctx.fillText('✦',p.x+p.w/2,p.y+p.h/2+8);
  });
}

function drawBlood(){
  bloodSplats.forEach(s=>{
    // pixel-art splat — chunky blobs
    const c=['#7a0000','#5a0000','#9a1010'];
    for(let i=0;i<6;i++){
      const ox=(Math.random()-0.5)*s.r, oy=(Math.random()-0.5)*s.r*0.6;
      const sr=8+Math.random()*16;
      // keep seeded per splat using index
      const sx=s.x+Math.cos(i/6*Math.PI*2)*s.r*0.4;
      const sy=s.y+Math.sin(i/6*Math.PI*2)*s.r*0.3;
      px(sx-sr/2,sy-sr/2,Math.ceil(sr),Math.ceil(sr*0.7),c[i%3]);
    }
    px(s.x-8,s.y-6,16,12,'#8a0808');
  });
}

function drawParticles(){
  particles.forEach(p=>{
    const a=p.life/p.maxLife;
    const sz=Math.max(2,Math.round(p.r*(0.5+a*0.5)));
    ctx.fillStyle=`rgba(${p.color},${a})`;
    ctx.fillRect(Math.round(p.x-sz/2),Math.round(p.y-sz/2),sz,sz);
  });
}

function drawSlash(){
  slashFx.forEach(s=>{
    const a=s.life/s.maxLife;
    // pixel arc — draw as thick chunky lines
    ctx.save();
    ctx.translate(Math.round(s.x+s.facing*18),Math.round(s.y));
    for(let i=0;i<8;i++){
      const ang=-0.7+i*0.175;
      const r1=60, r2=140;
      const bx=Math.cos(ang*s.facing)*r2, by=Math.sin(ang)*r2;
      const al=a*(1-Math.abs(i-3.5)/4);
      ctx.fillStyle=`rgba(160,0,200,${al})`;
      ctx.fillRect(Math.round(bx-4),Math.round(by-4),8,8);
      ctx.fillStyle=`rgba(220,100,255,${al*0.5})`;
      ctx.fillRect(Math.round(bx-1),Math.round(by-1),2,2);
    }
    ctx.restore();
  });
}

function drawChains(){
  chainFx.forEach(c=>{
    const a=c.life/c.maxLife;
    const steps=12;
    ctx.fillStyle=`rgba(180,0,220,${a*0.8})`;
    for(let i=0;i<=steps;i++){
      const t=i/steps;
      const cx=c.from.x+(c.to.x-c.from.x)*t;
      const cy=c.from.y+(c.to.y-c.from.y)*t+Math.sin(t*Math.PI)*-20;
      const sz=i%2===0?6:4;
      ctx.fillRect(Math.round(cx-sz/2),Math.round(cy-sz/2),sz,sz);
    }
  });
}

function drawNova(){
  if(!novaFx) return;
  const a=novaFx.life/novaFx.maxLife;
  // pixel ring — draw thick arc as squares
  const steps=48;
  for(let i=0;i<steps;i++){
    const ang=i/steps*Math.PI*2;
    const rx=KAZ.x+Math.cos(ang)*novaFx.r;
    const ry=KAZ.y+Math.sin(ang)*novaFx.r;
    const sz=a>0.5?8:6;
    ctx.fillStyle=`rgba(220,20,20,${a})`;
    ctx.fillRect(Math.round(rx-sz/2),Math.round(ry-sz/2),sz,sz);
  }
}

// ── PIXEL SPRITE DRAWERS ──────────────────────────────────
function drawMember(m){
  ctx.save();
  const s=m.scale;
  const bx=Math.round(m.x), by=Math.round(m.y);
  const bob=Math.sin(m.bobT*0.12)*4;

  if(!m.alive){
    ctx.globalAlpha=Math.max(0,1-(m.deathT-15)/40);
    ctx.translate(bx,by+4);
    ctx.rotate(Math.PI/2*Math.min(1,m.deathT/25));
  } else {
    ctx.translate(bx,by+bob);
  }

  const sc=Math.round(14*s), sh=Math.round(18*s);
  const hurt=m.hurtT>0&&Math.floor(m.hurtT/3)%2===0;

  // body (dress/armor)
  const dc=hurt?'#ff4444':m.dress;
  px(-sc,-sh*2,sc*2,sh*2,dc);
  // body shading right side
  px(sc-Math.round(3*s),-sh*2,Math.round(3*s),sh*2,'rgba(0,0,0,0.25)');
  // belt
  px(-sc,-Math.round(s*3),sc*2,Math.round(s*2),'rgba(0,0,0,0.3)');

  // head
  const hc=hurt?'#ffaaaa':m.skin;
  const hs=Math.round(10*s);
  px(-Math.round(5*s),-sh*2-hs,hs*2,hs,hc);
  // hair (top half of head)
  px(-Math.round(5*s),-sh*2-hs,hs*2,Math.round(5*s),m.hair);
  // face detail - eyes (2 dark pixels)
  if(!hurt){
    px(-Math.round(3*s),-sh*2-Math.round(6*s),Math.round(2*s),Math.round(2*s),'rgba(0,0,0,0.6)');
    px(Math.round(1*s),-sh*2-Math.round(6*s),Math.round(2*s),Math.round(2*s),'rgba(0,0,0,0.6)');
  } else {
    // hurt - X eyes
    px(-Math.round(3*s),-sh*2-Math.round(7*s),Math.round(2*s),Math.round(2*s),'#ff0000');
    px(Math.round(1*s),-sh*2-Math.round(7*s),Math.round(2*s),Math.round(2*s),'#ff0000');
  }
  // mouth - open crying O shape
  px(-Math.round(1*s),-sh*2-Math.round(3*s),Math.round(2*s),Math.round(3*s),'rgba(0,0,0,0.5)');

  // features per type
  if(m.type==='elf'){
    // big pointy ears
    px(-Math.round(6*s),-sh*2-Math.round(7*s),Math.round(2*s),Math.round(6*s),m.skin);
    px(Math.round(4*s),-sh*2-Math.round(7*s),Math.round(2*s),Math.round(6*s),m.skin);
    // ear tip accent
    px(-Math.round(6*s),-sh*2-Math.round(7*s),Math.round(2*s),Math.round(2*s),'rgba(255,220,180,0.5)');
    px(Math.round(4*s),-sh*2-Math.round(7*s),Math.round(2*s),Math.round(2*s),'rgba(255,220,180,0.5)');
  }
  if(m.type==='tiefling'){
    // left horn solid (tall)
    px(-Math.round(4*s),-sh*2-hs-Math.round(8*s),Math.round(2*s),Math.round(8*s),'#666');
    px(-Math.round(5*s),-sh*2-hs-Math.round(10*s),Math.round(2*s),Math.round(4*s),'#555');
    // right broken stub
    px(Math.round(2*s),-sh*2-hs-Math.round(5*s),Math.round(2*s),Math.round(4*s),'#555');
    px(Math.round(3*s),-sh*2-hs-Math.round(5*s),Math.round(2*s),Math.round(2*s),'#333');
  }
  if(m.type==='goliath'){
    // extra wide chunky shoulders
    px(-sc-Math.round(5*s),-sh*2,Math.round(5*s),Math.round(6*s),m.dress);
    px(sc,-sh*2,Math.round(5*s),Math.round(6*s),m.dress);
    // shoulder highlight
    px(-sc-Math.round(5*s),-sh*2,Math.round(5*s),Math.round(2*s),'rgba(255,255,255,0.1)');
    px(sc,-sh*2,Math.round(5*s),Math.round(2*s),'rgba(255,255,255,0.1)');
    // stone skin markings
    px(-Math.round(2*s),-sh*2-Math.round(6*s),Math.round(s),Math.round(4*s),'rgba(0,0,0,0.2)');
  }
  if(m.type==='genasi'){
    // wind aura — bigger orbiting dots
    const wa=0.4+Math.sin(m.bobT*0.15)*0.25;
    for(let i=0;i<8;i++){
      const ang=i/8*Math.PI*2+m.bobT*0.04;
      const ar=sc+Math.round(6*s);
      px(Math.round(Math.cos(ang)*ar),Math.round(Math.sin(ang)*(sh*1.2)-sh),4,4,`rgba(160,220,255,${wa})`);
    }
    // inner glow
    for(let i=0;i<4;i++){
      const ang=i/4*Math.PI*2+m.bobT*0.08;
      px(Math.round(Math.cos(ang)*(sc*0.6)),Math.round(Math.sin(ang)*(sh*0.6)-sh),2,2,`rgba(200,240,255,${wa*0.5})`);
    }
  }

  // health bar (pixelated, bigger)
  if(m.alive&&m.hp<m.maxHp){
    const bw=Math.round(sc*3), bh=6;
    const bx2=-Math.round(sc*1.5), by2=-sh*2-Math.round(16*s);
    px(bx2,by2,bw,bh,'#300');
    px(bx2,by2,Math.round(bw*m.hp/m.maxHp),bh,'#c00');
    px(bx2,by2,Math.round(bw*m.hp/m.maxHp),2,'#f44');
  }

  // name
  if(m.alive){
    ctx.fillStyle='rgba(220,180,140,0.75)';
    ctx.font=`bold ${Math.round(20*s)}px "Courier New",monospace`;
    ctx.textAlign='center';
    ctx.fillText(m.name,0,-sh*2-Math.round(26*s));
  }

  // chained indicator - bigger sparks
  if(m.chained>0){
    const ca=Math.min(1,m.chained/30);
    for(let i=0;i<6;i++){
      px(Math.round((Math.random()-0.5)*(sc*2)),Math.round(-sh-Math.random()*sh*2),4,4,`rgba(200,0,200,${ca})`);
    }
  }

  ctx.restore();
}

