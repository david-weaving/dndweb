function gameLoop(){
  if(!gameRunning) return;
  updateKazryn();
  updateParty();
  updateFx();

  // screen shake
  ctx.save();
  if(screenShake>0){
    ctx.translate(
      (Math.random()-0.5)*screenShake*1.5,
      (Math.random()-0.5)*screenShake*1.5
    );
  }

  drawBg();
  drawPillars();
  drawBlood();
  drawChains();
  drawParticles();
  drawSlash();
  drawNova();
  party.forEach(drawMember);
  drawSobTexts();
  drawKazryn();

  ctx.restore();
  updateAbilityUI();
  requestAnimationFrame(gameLoop);
}

